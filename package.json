{
  "name": "panostem",
  "private": true,
  "version": "0.5.0-alpha.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --mode web",
    "preview": "vite preview",
    "test": "node --experimental-strip-types scripts/unit_test.mjs && node --experimental-strip-types scripts/retrieval_test.mjs && node --experimental-strip-types scripts/search_golden.mjs && node scripts/index_baseline_test.mjs && npm run test:learning && npm run test:workbench && npm run test:studio",
    "test:learning": "node --experimental-strip-types scripts/learning_test.mjs",
    "test:web": "node --experimental-strip-types scripts/web_regression.mjs",
    "test:web:build": "npm run build:web && node --experimental-strip-types scripts/web_build_smoke.mjs",
    "test:desktop": "node scripts/desktop_regression.mjs",
    "tauri": "tauri",
    "benchmark": "node --experimental-strip-types scripts/retrieval_benchmark.mjs",
    "test:parity": "node --experimental-strip-types scripts/search_parity.mjs",
    "index:quality": "node --experimental-strip-types scripts/index_quality.mjs",
    "ontology:validate": "node --experimental-strip-types scripts/ontology_validate.mjs",
    "ontology:audit": "node --experimental-strip-types scripts/ontology_audit.mjs",
    "index:enrich": "node --experimental-strip-types scripts/enrich_index.mjs",
    "baseline": "node --experimental-strip-types scripts/retrieval_baseline.mjs",
    "test:workbench": "node --experimental-strip-types scripts/workbench_test.mjs",
    "benchmark:adversarial": "node --experimental-strip-types scripts/adversarial_benchmark.mjs",
    "test:visual-bundle": "node scripts/visual_bundle_security.mjs",
    "test:studio": "node --experimental-strip-types scripts/studio_test.mjs",
    "test:runtime": "python -m unittest discover -s tests/runtime -v",
    "test:runtime:smoke": "python scripts/runtime_smoke.py",
    "lint": "eslint src/studio",
    "test:studio:desktop": "node scripts/studio_desktop_regression.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@uiw/react-codemirror": "4.25.12",
    "fflate": "0.8.3",
    "jsxgraph": "1.14.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
