{
  "name": "stem-visual-explorer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --mode web",
    "preview": "vite preview",
    "test": "node --experimental-strip-types scripts/unit_test.mjs && node --experimental-strip-types scripts/retrieval_test.mjs && node --experimental-strip-types scripts/search_golden.mjs",
    "test:web": "node scripts/web_regression.mjs",
    "test:web:build": "npm run build:web && node scripts/web_build_smoke.mjs",
    "test:desktop": "node scripts/desktop_regression.mjs",
    "tauri": "tauri",
    "benchmark": "node --experimental-strip-types scripts/retrieval_benchmark.mjs",
    "test:parity": "node --experimental-strip-types scripts/search_parity.mjs",
    "index:quality": "node --experimental-strip-types scripts/index_quality.mjs",
    "ontology:validate": "node --experimental-strip-types scripts/ontology_validate.mjs",
    "ontology:audit": "node --experimental-strip-types scripts/ontology_audit.mjs",
    "index:enrich": "node --experimental-strip-types scripts/enrich_index.mjs",
    "baseline": "node --experimental-strip-types scripts/retrieval_baseline.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.3.1"
  }
}
