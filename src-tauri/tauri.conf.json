{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STEM Visual Explorer",
  "version": "0.4.0-alpha.1",
  "identifier": "org.stemvisualexplorer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "STEM Visual Explorer",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Visual search for mathematics and physics.",
    "longDescription": "A lightweight local STEM search client that aggregates interactive math and physics resources from multiple high quality websites into one unified interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
